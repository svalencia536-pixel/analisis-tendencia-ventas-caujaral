# Obligatorias: IDs del reporte de Power BI publicado
# Extrae los valores del parametro ?r= de la URL del reporte:
# ?r=eyJrIjoiRESO-RESOURCE-KEY-eyJrIjoiRESODATASET-ID","ti":"DATASET-ID","r":"REPORT-ID"}
#
# O bien: abre la URL del reporte, anda al navegador > Network, busca el primer POST
# a querydata, mira el payload de "ApplicationContext", copiá los tres UUIDs de ahí.

PBI_RESOURCE_KEY=61f3e1a9-ed07-485a-b2a4-fe2e5f061b6a
PBI_DATASET_ID=8d41e2a9-2d13-436b-8a97-ac4b0764b74a
PBI_REPORT_ID=628aee9c-62c6-4668-9350-92ff8b33ea29

# Opcional: si quieres cerrar el dashboard con contraseña
# DASHBOARD_PASSWORD=tuContraseña
# DASHBOARD_USER=caujaral

# Opcional: hora del refresco diario (en hora de Bogotá)
# HORA_REFRESCO=6
